// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Gasto {
  id           Int      @id @default(autoincrement())
  comercio     String
  monto        Float
  fecha        String
  categoria    String
  esRecurrente Boolean  @default(false)
  registradoEn DateTime @default(now())
  desglose     GastoCategoria[]

  @@index([fecha])
}

// Cuando un recibo mezcla categorías (ej. comida + aseo en la misma factura), el
// gasto guarda su categoria/monto de siempre (el rubro principal) más estas filas
// con el detalle. Vacío cuando el usuario no divide el gasto.
model GastoCategoria {
  id        Int    @id @default(autoincrement())
  gastoId   Int
  gasto     Gasto  @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  categoria String
  monto     Float

  @@index([gastoId])
}
